<h1>Market maker demo</h1>

<div>
    <label for="game">Pick a game</label>
    <select id="game">
        <option value="">-- Select a game --</option>

        <% games.forEach(game => { %>
            <option value="<%= game.id %>"
                data-home-id="<%= game.home_team_id %>" data-home-name="<%= game.home_team_name %>"
                data-away-id="<%= game.away_team_id %>" data-away-name="<%= game.away_team_name %>">
                <%= game.away_team_name %> vs. <%= game.home_team_name %>
            </option>
        <% }); %>
    </select>
</div>

<div>
    <label for="team">Pick a team</label>
    <select id="team" disabled>
        <option value="">-- Select a team --</option>
    </select>
</div>

<script src="/js/markets.js" defer></script>