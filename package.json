{
  "dependencies": {
    "dotenv": "^18.0.8",
    "ejs": "^7.0.2",
    "express": "^5.3.0",
    "express-ejs-layouts": "^2.5.1",
    "node-cron": "^4.6.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "dotenv-cli": "^11.1.0",
    "nodemon": "^3.1.14"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "db:init": "dotenv -e .env -- psql --dbname=%DATABASE_URL% --file=src/db/init.sql",
    "db:reset": "dotenv -e .env -- psql --dbname=%DATABASE_URL% --file=src/db/reset.sql"
  }
}
