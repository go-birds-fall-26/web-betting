{
  "dependencies": {
    "dotenv": "^18.0.8",
    "ejs": "^7.0.2",
    "express": "^5.3.0",
    "express-ejs-layouts": "^2.5.1",
    "node-cron": "^4.6.0",
    "pg": "^8.23.1",
    "stripe": "^23.1.0",
    "argon2": "^0.45.2"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "nodemon": "^3.1.14"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "dev:stripe": "concurrently -k \"npm run dev\" \"npm run stripe:listen\"",
    "stripe:listen": "stripe listen --events checkout.session.completed --forward-to localhost:3000/webhooks/stripe",
    "seed": "node src/db/scripts/run-seed",
    "seed:reset": "node src/db/scripts/run-seed --reset"
  }
}
